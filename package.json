{
  "name": "duitku-ts",
  "version": "1.0.0",
  "description": "Duitku TypeScript SDK for Node.js and Bun - Payment Gateway Integration",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:node": "node node_modules/vitest/vitest.mjs run",
    "test:bun": "bunx vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "duitku",
    "duitku-ts",
    "payment",
    "gateway",
    "indonesia",
    "sdk",
    "payment-gateway",
    "e-wallet",
    "virtual-account",
    "credit-card",
    "qris",
    "typescript",
    "nodejs",
    "bun"
  ],
  "author": "Imam Ali Mustofa",
  "homepage": "https://darkterminal.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/darkterminal/duitku-ts.git"
  },
  "bugs": {
    "url": "https://github.com/darkterminal/duitku-ts/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "^1.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
